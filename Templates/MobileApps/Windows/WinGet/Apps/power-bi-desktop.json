        "notes": "Bundled from IntuneGet public icons."
    },
    "metadata": {
        "categories": [
            "MobileApps",
            "Analytics"
        ],
        "tags": [
            "mobile-apps",
            "analytics",
            "power-bi"
        ],
        "notes": [],
