{
    "$schema": "../Schemas/winGetAppTemplate.schema.json",
    "schemaVersion": "1.0.0",
    "templateId": "zoom-workplace",
    "packageIdentifier": "Zoom.Zoom",
    "displayName": "Zoom Workplace",
    "publisher": "Zoom Communications, Inc.",
    "description": "Starter-pack WinGet template for Zoom Workplace Win32 packaging.",
    "package": {
        "source": "WinGet",
        "match": {
            "packageIdentifier": "Zoom.Zoom",
            "architectures": [
                "x64"
            ],
            "installerTypes": [
                "msi",
                "exe"
            ],
            "scope": "machine",
            "locale": "en-US",
            "channel": null
        }
    },
    "install": {
        "command": "winget install --id Zoom.Zoom --exact --silent --scope machine --accept-package-agreements --accept-source-agreements",
        "experience": "system",
        "restartBehavior": "suppress"
    },
    "uninstall": {
        "command": "winget uninstall --id Zoom.Zoom --exact --scope machine --silent",
        "behavior": "allow"
    },
    "detection": {
        "strategy": "generated"
    },
    "requirements": {
        "minimumSupportedWindowsRelease": "W10_22H2",
